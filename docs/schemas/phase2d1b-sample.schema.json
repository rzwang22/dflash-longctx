{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "task", "sample_id", "source_sample_id", "nominal_prompt_length", "actual_prompt_length", "selector_mode", "node_budget_cap", "generated_token_count", "control_repeats"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "selector_mode": {"enum": ["reference_dflash", "top1_packed_tree", "global_fixed", "context_rule", "decision_stump"]},
    "node_budget_cap": {"enum": [16, 32]},
    "generated_token_count": {"type": "integer", "minimum": 0},
    "control_repeats": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
