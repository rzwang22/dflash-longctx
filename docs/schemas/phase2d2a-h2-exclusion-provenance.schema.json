{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2d2a-h2-exclusion-provenance.schema.json",
  "title": "Phase 2D.2A-H2.0 target-blind exclusion provenance",
  "type": "object",
  "required": ["schema_version", "phase", "status", "target_blind", "selection_or_exclusion_uses_model_outputs", "identity_fields_read", "forbidden_outcome_fields_read", "forbidden_outcome_fields", "execution_identity_artifact_names", "result_roots", "scanned_artifacts", "scanned_artifact_count", "excluded_identity_count", "excluded_identities", "exclusion_completed_before_h2_model_output_exists"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "phase": {"const": "2D.2A-H2.0"},
    "status": {"const": "complete"},
    "target_blind": {"const": true},
    "selection_or_exclusion_uses_model_outputs": {"const": false},
    "identity_fields_read": {"const": ["task", "longbench_task", "sample_id", "source_sample_id", "source_text_sha256"]},
    "forbidden_outcome_fields_read": {"const": false},
    "execution_identity_artifact_names": {"type": "array", "minItems": 1},
    "scanned_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["artifact_path", "artifact_sha256", "record_count", "identity_record_count"]
      }
    },
    "scanned_artifact_count": {"type": "integer", "minimum": 0},
    "excluded_identity_count": {"type": "integer", "minimum": 0},
    "excluded_identities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task", "sample_id", "source_sample_id", "source_text_sha256", "evidence"],
        "properties": {"task": {"enum": ["gov_report", "qasper", "hotpotqa"]}}
      }
    },
    "exclusion_completed_before_h2_model_output_exists": {"const": true}
  }
}
