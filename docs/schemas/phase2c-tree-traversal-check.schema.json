{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2c-tree-traversal-check.schema.json",
  "title": "Phase 2C.2 online tree traversal check",
  "type": "object",
  "required": ["schema_version", "task", "sample_id", "nominal_prompt_length", "configuration_id", "round_index", "status", "root_token_id", "nodes", "accepted_path_node_indices", "accepted_depth", "terminal_parent_index", "correction_or_bonus_token_id", "correction_or_bonus_kind", "committed_node_indices", "kv_gather_indices", "next_round_root_token_id", "next_round_root_absolute_position", "context_length_before", "context_length_after", "persistent_kv_length_before", "persistent_kv_length_after", "transition_checks", "structural_mask_issues", "allowed_attention_positions_by_node", "checks", "cache_before_comparable_summary", "cache_after_comparable_summary", "is_first_divergent_round"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task": {"enum": ["gov_report", "qasper", "hotpotqa"]},
    "sample_id": {"type": "string", "minLength": 1},
    "nominal_prompt_length": {"type": "integer", "minimum": 1},
    "configuration_id": {"type": "string", "minLength": 1},
    "round_index": {"type": "integer", "minimum": 0},
    "status": {"enum": ["pass", "fail"]},
    "root_token_id": {"type": "integer"},
    "nodes": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "accepted_path_node_indices": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "accepted_depth": {"type": "integer", "minimum": 0, "maximum": 15},
    "terminal_parent_index": {"type": "integer", "minimum": 0},
    "correction_or_bonus_token_id": {"type": "integer"},
    "correction_or_bonus_kind": {"enum": ["correction", "bonus"]},
    "committed_node_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "kv_gather_indices": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "next_round_root_token_id": {"type": "integer"},
    "next_round_root_absolute_position": {"type": "integer", "minimum": 0},
    "context_length_before": {"type": "integer", "minimum": 1},
    "context_length_after": {"type": "integer", "minimum": 1},
    "persistent_kv_length_before": {"type": "integer", "minimum": 1},
    "persistent_kv_length_after": {"type": "integer", "minimum": 1},
    "transition_checks": {"type": "array", "items": {"type": "object"}},
    "structural_mask_issues": {"type": "array", "items": {"type": "string"}},
    "allowed_attention_positions_by_node": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "items": {"type": "integer", "minimum": 0}}
    },
    "checks": {
      "type": "object",
      "required": ["structural_checks_passed", "traversal_checks_passed", "kv_root_transition_checks_passed", "all_checks_passed"],
      "properties": {
        "structural_checks_passed": {"type": "boolean"},
        "traversal_checks_passed": {"type": "boolean"},
        "kv_root_transition_checks_passed": {"type": "boolean"},
        "all_checks_passed": {"type": "boolean"}
      }
    },
    "cache_before_comparable_summary": {"type": "array", "items": {"type": "object"}},
    "cache_after_comparable_summary": {"type": "array", "items": {"type": "object"}},
    "is_first_divergent_round": {"type": "boolean"}
  }
}
