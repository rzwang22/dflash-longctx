{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2d2-round.schema.json",
  "title": "Phase 2D.2A refinement round",
  "type": "object",
  "required": ["schema_version", "task", "sample_id", "nominal_prompt_length", "configuration_id", "round_index", "accepted_draft_token_count", "committed_token_count", "phase2d2", "candidate_quality"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "round_index": {"type": "integer", "minimum": 0},
    "candidate_quality": {
      "type": "object",
      "properties": {
        "availability": {"enum": ["available", "unavailable"]},
        "target_label_authority": {"const": "original_dflash_reference"},
        "target_label_source": {"const": "original_dflash_absolute_continuation"},
        "target_label_used_for_runtime_selection": {"const": false},
        "semantic_generated_prefix_length": {"type": ["integer", "null"], "minimum": 0},
        "semantic_prefix_token_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "reference_alignment_available": {"type": "boolean"},
        "reference_alignment_reason": {"type": ["string", "null"]},
        "target_label_evidence_available": {"type": "boolean"},
        "target_label_evidence_unavailable_reason": {"type": ["string", "null"]},
        "positions": {"type": "array"}
      }
    },
    "phase2d2": {
      "type": "object",
      "required": ["candidate_merge_mode", "initial_parallel_draft_forward_count", "conditional_refinement_forward_count", "base_only_conditional_refinement_bypassed", "actual_verification_tree_source", "refined_tree_replaced_seed_tree", "external_request_batch_size", "internal_branch_batch_size", "conditional_input_token_ids", "temporary_refinement_state_committed", "selected_tree_node_count", "actual_verified_node_count", "root_count", "fixed_root_inclusive_node_budget", "node_budget_invariant_passed", "verification_mode", "fallback_replay_executed", "fallback_query_lengths", "authoritative_committed_cache_length", "authoritative_committed_target_kv_layer_lengths", "correction_or_bonus_committed_in_current_round", "sibling_kv_removed_from_committed_cache", "final_output_source"],
      "properties": {
        "initial_parallel_draft_forward_count": {"const": 1},
        "conditional_refinement_forward_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "base_only_conditional_refinement_bypassed": {"type": "boolean"},
        "actual_verification_tree_source": {"enum": ["phase2c_frozen_selector_seed_tree", "phase2d2_refined_tree"]},
        "refined_tree_replaced_seed_tree": {"type": "boolean"},
        "external_request_batch_size": {"const": 1},
        "conditional_input_token_ids": {"type": "array"},
        "temporary_refinement_state_committed": {"const": false},
        "root_count": {"const": 1},
        "fixed_root_inclusive_node_budget": {"enum": [16, 32]},
        "node_budget_invariant_passed": {"const": true},
        "verification_mode": {"enum": ["packed_native", "always_replay", "margin_guarded_replay", "always_fixed_shape_recheck", "margin_guarded_fixed_shape_recheck"]},
        "fallback_executed": {"type": "boolean"},
        "fallback_executor": {"enum": ["none", "q1_replay", "fixed_shape_recheck"]},
        "fallback_forward_count": {"type": "integer", "minimum": 0},
        "fallback_query_lengths": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "fixed_shape_fallback_triggered": {"type": "boolean"},
        "fixed_shape_fallback_executed": {"type": "boolean"},
        "fixed_shape_forward_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "fixed_shape_query_lengths": {"type": "array", "items": {"const": 16}},
        "fixed_shape_temporary_kv_layer_lengths": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "fixed_shape_temporary_block_length": {"type": ["integer", "null"]},
        "fixed_shape_cropped_committed_kv_length": {"type": ["integer", "null"]},
        "fixed_shape_mask_tail_discarded_count": {"type": "integer", "minimum": 0, "maximum": 15},
        "fixed_shape_round_entry_snapshot_isolated": {"type": ["boolean", "null"]},
        "fixed_shape_snapshot_matches_preverification_cache": {"type": ["boolean", "null"]},
        "authoritative_committed_target_kv_layer_lengths": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "authoritative_committed_target_hidden_length": {"type": "integer", "minimum": 1},
        "authoritative_next_root_absolute_sequence_position": {"type": "integer", "minimum": 0},
        "authoritative_next_root_transition_slot_count": {"const": 1},
        "authoritative_next_root_matches_output_transition": {"const": true},
        "correction_or_bonus_committed_in_current_round": {"const": false},
        "sibling_kv_removed_from_committed_cache": {"const": true},
        "fixed_shape_mask_tail_absent_from_committed_cache": {"type": ["boolean", "null"]},
        "final_output_source": {"enum": ["packed_native", "shape_stable_q1_replay", "fixed_shape_recheck"]}
      },
      "allOf": [
        {
          "if": {"properties": {"verification_mode": {"enum": ["always_replay", "margin_guarded_replay"]}}},
          "then": {"properties": {"fallback_query_lengths": {"items": {"const": 1}}}}
        },
        {
          "if": {"properties": {"verification_mode": {"enum": ["always_fixed_shape_recheck", "margin_guarded_fixed_shape_recheck"]}}},
          "then": {
            "required": ["fallback_executed", "fallback_executor", "fallback_forward_count", "fixed_shape_fallback_triggered", "fixed_shape_fallback_executed", "fixed_shape_forward_count", "fixed_shape_query_lengths", "fixed_shape_temporary_kv_layer_lengths", "fixed_shape_temporary_block_length", "fixed_shape_cropped_committed_kv_length", "fixed_shape_mask_tail_discarded_count", "fixed_shape_round_entry_snapshot_isolated", "fixed_shape_snapshot_matches_preverification_cache", "authoritative_committed_target_hidden_length", "authoritative_next_root_absolute_sequence_position", "authoritative_next_root_transition_slot_count", "authoritative_next_root_matches_output_transition", "fixed_shape_mask_tail_absent_from_committed_cache"],
            "properties": {"fallback_query_lengths": {"items": {"const": 16}}}
          }
        }
      ]
    }
  }
}
