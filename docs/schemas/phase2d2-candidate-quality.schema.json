{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2d2-candidate-quality.schema.json",
  "title": "Phase 2D.2A post-hoc candidate-quality evidence",
  "type": "object",
  "required": [
    "availability",
    "unavailable_reason",
    "label_authority",
    "label_source",
    "target_label_authority",
    "target_label_source",
    "target_label_used_for_runtime_selection",
    "target_labels_used_for_runtime_selection",
    "semantic_generated_prefix_length",
    "semantic_prefix_token_sha256",
    "reference_alignment_available",
    "reference_alignment_reason",
    "target_label_evidence_available",
    "target_label_evidence_unavailable_reason",
    "label_evidence_role",
    "q1_replay_used_as_target_label_source",
    "target_only_used_as_target_label_source",
    "positions",
    "correct_prefix_survival_depth",
    "first_pruning_depth"
  ],
  "properties": {
    "availability": {"enum": ["available", "unavailable"]},
    "unavailable_reason": {"type": ["string", "null"]},
    "label_authority": {"type": ["string", "null"]},
    "label_source": {"type": ["string", "null"]},
    "target_label_authority": {"type": ["string", "null"]},
    "target_label_source": {"type": ["string", "null"]},
    "target_label_used_for_runtime_selection": {"const": false},
    "target_labels_used_for_runtime_selection": {"const": false},
    "semantic_generated_prefix_length": {"type": ["integer", "null"], "minimum": 0},
    "semantic_prefix_token_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "reference_alignment_available": {"type": "boolean"},
    "reference_alignment_reason": {"type": ["string", "null"]},
    "target_label_evidence_available": {"type": "boolean"},
    "target_label_evidence_unavailable_reason": {"type": ["string", "null"]},
    "label_evidence_role": {"const": "post_hoc_evaluation_only"},
    "q1_replay_used_as_target_label_source": {"const": false},
    "target_only_used_as_target_label_source": {"const": false},
    "fixed_shape_used_as_target_label_authority": {"const": false},
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "position_index",
          "absolute_generated_token_offset",
          "target_token_id",
          "base_top_m_membership",
          "conditional_top_r_membership",
          "conditional_candidate_set_available",
          "conditional_candidate_set_unavailable_reason",
          "merged_membership",
          "selected_tree_membership",
          "refined_only_target_recovery",
          "best_base_rank",
          "best_conditional_rank",
          "target_token_rank_improvement",
          "target_label_authority",
          "target_label_source",
          "target_label_used_for_runtime_selection",
          "semantic_generated_prefix_length",
          "semantic_prefix_token_sha256",
          "reference_alignment_available",
          "reference_alignment_reason",
          "reference_parent_prefix_token_ids",
          "reference_prefix_through_position_token_ids"
        ],
        "properties": {
          "position_index": {"type": "integer", "minimum": 1, "maximum": 15},
          "absolute_generated_token_offset": {"type": "integer", "minimum": 1},
          "target_token_id": {"type": "integer", "minimum": 0},
          "base_top_m_membership": {"type": "boolean"},
          "conditional_top_r_membership": {"type": "boolean"},
          "conditional_candidate_set_available": {"type": "boolean"},
          "conditional_candidate_set_unavailable_reason": {"type": ["string", "null"]},
          "merged_membership": {"type": "boolean"},
          "selected_tree_membership": {"type": "boolean"},
          "refined_only_target_recovery": {"type": "boolean"},
          "best_base_rank": {"type": ["integer", "null"], "minimum": 1},
          "best_conditional_rank": {"type": ["integer", "null"], "minimum": 1},
          "target_token_rank_improvement": {"type": ["integer", "null"]},
          "target_label_authority": {"const": "original_dflash_reference"},
          "target_label_source": {"const": "original_dflash_absolute_continuation"},
          "target_label_used_for_runtime_selection": {"const": false},
          "semantic_generated_prefix_length": {"type": "integer", "minimum": 0},
          "semantic_prefix_token_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reference_alignment_available": {"const": true},
          "reference_alignment_reason": {"type": "null"},
          "target_label_evidence_available": {"const": true},
          "target_label_evidence_unavailable_reason": {"type": "null"},
          "reference_parent_prefix_token_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "reference_prefix_through_position_token_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "matching_conditional_refined_prefixes": {"type": "array", "items": {"type": "array", "items": {"type": "integer", "minimum": 0}}}
        }
      }
    },
    "correct_prefix_survival_depth": {"type": "integer", "minimum": 0, "maximum": 15},
    "first_pruning_depth": {"type": ["integer", "null"], "minimum": 1, "maximum": 15}
  },
  "allOf": [
    {
      "if": {"properties": {"availability": {"const": "available"}}},
      "then": {
        "properties": {
          "unavailable_reason": {"type": "null"},
          "label_authority": {"const": "original_dflash_reference"},
          "label_source": {"const": "original_dflash_absolute_continuation"},
          "target_label_authority": {"const": "original_dflash_reference"},
          "target_label_source": {"const": "original_dflash_absolute_continuation"},
          "reference_alignment_available": {"const": true},
          "reference_alignment_reason": {"type": "null"},
          "target_label_evidence_available": {"const": true},
          "target_label_evidence_unavailable_reason": {"type": "null"},
          "positions": {"minItems": 1}
        }
      }
    }
  ]
}
