{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2c-gold-comparison-summary.schema.json",
  "title": "Phase 2C.1 comparison-mode summary",
  "type": "object",
  "required": ["schema_version", "status", "logit_record_count", "kv_record_count", "groups", "interpretation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["not_run", "ok", "error"]},
    "logit_record_count": {"type": "integer", "minimum": 0},
    "kv_record_count": {"type": "integer", "minimum": 0},
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {"enum": ["not_run", "pass_exact", "pass_semantic_with_numerical_variation", "fail_semantic", "fail_structural"]},
          "semantic_status": {"enum": ["not_run", "pass", "fail"]},
          "first_numerical_threshold_exceeding_depth": {"type": ["integer", "null"], "minimum": 0},
          "first_numerical_threshold_exceeding_node": {"type": ["integer", "null"], "minimum": 0},
          "first_top8_mismatch_depth": {"type": ["integer", "null"], "minimum": 0},
          "first_top8_mismatch_node": {"type": ["integer", "null"], "minimum": 0},
          "first_semantic_mismatch_depth": {"type": ["integer", "null"], "minimum": 0},
          "first_semantic_mismatch_node": {"type": ["integer", "null"], "minimum": 0},
          "first_structural_mismatch_depth": {"type": ["integer", "null"], "minimum": 0},
          "first_structural_mismatch_node": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "interpretation": {"type": "object"}
  }
}
