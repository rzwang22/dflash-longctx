{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2b1-capture-source-provenance.schema.json",
  "title": "Phase 2B instrumented capture source provenance",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "repository_custom_code_commit",
    "base_model_id",
    "base_model_revision",
    "implementation",
    "materialized_model_path",
    "custom_code_sha256",
    "actual_loaded_module_path",
    "actual_loaded_module_sha256",
    "loaded_source_matches_repository",
    "actual_loaded_dependencies",
    "controlled_but_not_imported_files",
    "spec_generate",
    "generation_helpers",
    "materialization_id",
    "weight_provenance",
    "target",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["started", "ok", "error"]},
    "repository_custom_code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_model_id": {"const": "z-lab/Qwen3-8B-DFlash-b16"},
    "base_model_revision": {"const": "9b41424b7109f9c5413454f481b09a82b85333f4"},
    "implementation": {"const": "instrumented"},
    "materialized_model_path": {"type": "string", "minLength": 1},
    "custom_code_sha256": {"type": "object", "minProperties": 1},
    "actual_loaded_module_path": {"type": "string", "minLength": 1},
    "actual_loaded_module_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "loaded_source_matches_repository": {"const": true},
    "actual_loaded_dependencies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["actual_loaded_sha256", "matches_repository"],
        "properties": {
          "actual_loaded_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "matches_repository": {"const": true}
        }
      }
    },
    "controlled_but_not_imported_files": {"type": "array", "items": {"type": "string"}},
    "spec_generate": {"type": "object"},
    "generation_helpers": {"type": "object"},
    "materialization_id": {"type": "string", "minLength": 1},
    "weight_provenance": {"type": "array", "minItems": 1},
    "target": {"type": "object", "minProperties": 1},
    "original": {"type": ["object", "null"], "description": "Optional legacy A/B provenance; Phase 2B capture does not emit it."},
    "error": {"type": ["object", "null"]}
  }
}
