{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2d2a-h2-aggregation-rules.schema.json",
  "title": "Phase 2D.2A-H2 preregistered aggregation rules",
  "type": "object",
  "required": ["schema_version", "phase", "status", "primary_node_budget", "primary_actual_work_regime", "secondary_node_budget", "secondary_actual_work_regime", "secondary_can_override_primary_conclusion", "independent_tasks", "independent_task_count", "same_task_replication_tasks", "govreport_contributes_to_independent_task_count", "aggregation_unit_for_final_stability", "combined_sample_weighted_global_pool_can_replace_task_level_rule", "candidate_rate_aggregation", "online_efficiency_aggregation", "required_task_level_metrics", "per_physical_sample_paired_values_required", "sample_level_sign_distribution_required", "sample_heterogeneity_must_be_preserved", "stable_cross_task_same_work_signal_rule", "correctness_hard_gate", "mechanism_decomposition_fields", "reranking_or_tree_reallocation_signal_rule", "heldout_refined_only_recovery_does_not_rewrite_h1", "cost_axes", "lightweight_dependency_model_claimed_to_solve_verifier_overhead", "speedup_claim_authorized", "candidate_label_authority", "candidate_label_source", "q1_replay_used_as_target_label_source", "model_forward_executed"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "phase": {"const": "2D.2A-H2.0"},
    "status": {"const": "frozen_not_executed"},
    "primary_node_budget": {"const": 16},
    "primary_actual_work_regime": {"const": "same_actual_verification_work"},
    "secondary_node_budget": {"const": 32},
    "secondary_actual_work_regime": {"const": "budget_cap_expansion"},
    "secondary_can_override_primary_conclusion": {"const": false},
    "independent_tasks": {"const": ["qasper", "hotpotqa"]},
    "independent_task_count": {"const": 2},
    "same_task_replication_tasks": {"const": ["gov_report"]},
    "govreport_contributes_to_independent_task_count": {"const": false},
    "aggregation_unit_for_final_stability": {"const": "task_context_stratum"},
    "combined_sample_weighted_global_pool_can_replace_task_level_rule": {"const": false},
    "candidate_rate_aggregation": {"const": "pooled_valid_labelled_positions_within_task"},
    "per_physical_sample_paired_values_required": {"const": true},
    "sample_level_sign_distribution_required": {"const": true},
    "sample_heterogeneity_must_be_preserved": {"const": true},
    "heldout_refined_only_recovery_does_not_rewrite_h1": {"const": true},
    "cost_axes": {"const": ["dependency_modeling_cost", "correctness_preserving_verifier_cost"]},
    "lightweight_dependency_model_claimed_to_solve_verifier_overhead": {"const": false},
    "speedup_claim_authorized": {"const": false},
    "candidate_label_authority": {"const": "original_dflash_reference"},
    "candidate_label_source": {"const": "original_dflash_absolute_continuation"},
    "q1_replay_used_as_target_label_source": {"const": false},
    "model_forward_executed": {"const": false}
  }
}
