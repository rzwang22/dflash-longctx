{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2c-reference-state-differential.schema.json",
  "title": "Phase 2C.4.2 absolute-prefix actual-decision differential",
  "type": "object",
  "required": [
    "schema_version", "task", "sample_id", "nominal_prompt_length",
    "actual_prompt_length", "configuration_id", "generated_prefix_length",
    "absolute_prefix_alignment_used", "comparison_status",
    "reference_checkpoint_provenance", "tree_checkpoint_provenance",
    "semantic_prefix_token_exact", "reference_round_index", "tree_round_index",
    "round_segmentation_equal_assumed", "target_kv", "target_hidden",
    "draft_state", "semantic_probe", "packed_verifier_evidence",
    "candidate_alignment_status", "candidate_alignment_reason",
    "reference_actual_proposal_token_ids", "reference_candidate_top1_token_ids",
    "tree_candidate_top1_token_ids", "proposal_top1_semantically_aligned",
    "reference_actual_token_id", "tree_actual_token_id", "actual_token_equal",
    "actual_token_divergence", "actual_reference_tree_token_divergence",
    "actual_token_evidence_provenance", "actual_decision_oracle_source",
    "packed_tree_argmax_token_id", "packed_tree_argmax_matches_actual_reference",
    "packed_tree_argmax_matches_actual_tree", "packed_tree_verifier_decision_relevant",
    "packed_tree_structural_evidence_passed", "native_dense_replay_token_id",
    "native_dense_replay_matches_actual_reference", "same_mask_replay_token_id",
    "same_mask_replay_matches_actual_reference", "math_replay_token_id",
    "math_replay_matches_actual_reference", "dense_replay_control_only",
    "supporting_numerical_control_modes",
    "local_packed_verifier_numerical_divergence_supported",
    "reference_probe_argmax_token_id", "reference_probe_faithful",
    "reference_probe_fidelity_status", "reference_probe_execution_provenance",
    "tree_probe_argmax_token_id", "tree_probe_faithful",
    "tree_probe_fidelity_status", "native_dense_replay_control_flip",
    "same_mask_control_flip", "math_control_flip",
    "local_packed_verifier_decision_flip", "commit_transition_comparable",
    "commit_transition_semantics_equal", "round_segmentation_equal",
    "round_segmentation_difference_observed", "transition_overlap_start_offset",
    "transition_overlap_end_offset", "transition_overlap_token_exact",
    "transition_overlap_token_count", "first_transition_semantic_mismatch_offset",
    "first_transition_reference_token_id", "first_transition_tree_token_id",
    "segmentation_only_difference", "transition_semantic_mismatch",
    "transition_mismatch_causal", "numerical_state_difference_observed",
    "structural_state_difference_observed", "draft_candidate_difference_observed",
    "semantic_consequence_observed", "mere_numerical_variation_only",
    "classification_evidence_prefix", "classification_evidence_source",
    "classification_priority", "classification_evidence_complete",
    "classification_evidence_issues", "downstream_consequence_only", "unresolved_reason"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task": {"enum": ["gov_report", "qasper", "hotpotqa"]},
    "sample_id": {"type": "string", "minLength": 1},
    "nominal_prompt_length": {"type": "integer", "minimum": 1},
    "actual_prompt_length": {"type": "integer", "minimum": 1},
    "configuration_id": {"type": "string", "minLength": 1},
    "generated_prefix_length": {"type": "integer", "minimum": 0},
    "absolute_prefix_alignment_used": {"const": true},
    "comparison_status": {"enum": ["actual_reference_checkpoint_vs_actual_tree_checkpoint", "actual_reference_checkpoint_vs_diagnostic_replay", "diagnostic_replay_vs_actual_tree_checkpoint", "diagnostic_replay_vs_diagnostic_replay", "not_directly_comparable"]},
    "reference_checkpoint_provenance": {"enum": ["actual_reference_checkpoint", "diagnostic_replay", "not_directly_comparable"]},
    "tree_checkpoint_provenance": {"enum": ["actual_tree_checkpoint", "diagnostic_replay", "not_directly_comparable"]},
    "semantic_prefix_token_exact": {"type": ["boolean", "null"]},
    "reference_round_index": {"type": ["integer", "null"], "minimum": 0},
    "tree_round_index": {"type": ["integer", "null"], "minimum": 0},
    "round_segmentation_equal_assumed": {"const": false},
    "target_kv": {"type": "object"},
    "target_hidden": {"type": "object"},
    "draft_state": {"type": "object"},
    "semantic_probe": {"type": "object"},
    "candidate_alignment_status": {"enum": ["aligned", "candidate_capture_alignment_inconsistent", "not_directly_comparable", "semantic_context_mismatch", "invalid_draft_token_count", "missing_actual_proposal"]},
    "candidate_alignment_reason": {"type": ["string", "null"]},
    "reference_actual_proposal_token_ids": {"type": ["array", "null"], "items": {"type": "integer"}, "minItems": 15, "maxItems": 15},
    "reference_candidate_top1_token_ids": {"type": ["array", "null"], "items": {"type": "integer"}, "minItems": 15, "maxItems": 15},
    "tree_candidate_top1_token_ids": {"type": ["array", "null"], "items": {"type": "integer"}, "minItems": 15, "maxItems": 15},
    "proposal_top1_semantically_aligned": {"type": ["boolean", "null"]},
    "packed_verifier_evidence": {"type": "array", "items": {"type": "object"}},
    "reference_actual_token_id": {"type": ["integer", "null"]},
    "tree_actual_token_id": {"type": ["integer", "null"]},
    "actual_token_equal": {"type": ["boolean", "null"]},
    "actual_token_divergence": {"type": "boolean"},
    "actual_reference_tree_token_divergence": {"type": "boolean"},
    "actual_token_evidence_provenance": {"type": "object"},
    "actual_decision_oracle_source": {"const": "actual_original_dflash_output"},
    "packed_tree_argmax_token_id": {"type": ["integer", "null"]},
    "packed_tree_argmax_matches_actual_reference": {"type": ["boolean", "null"]},
    "packed_tree_argmax_matches_actual_tree": {"type": ["boolean", "null"]},
    "packed_tree_verifier_decision_relevant": {"type": "boolean"},
    "packed_tree_structural_evidence_passed": {"type": "boolean"},
    "native_dense_replay_token_id": {"type": ["integer", "null"]},
    "native_dense_replay_matches_actual_reference": {"type": ["boolean", "null"]},
    "same_mask_replay_token_id": {"type": ["integer", "null"]},
    "same_mask_replay_matches_actual_reference": {"type": ["boolean", "null"]},
    "math_replay_token_id": {"type": ["integer", "null"]},
    "math_replay_matches_actual_reference": {"type": ["boolean", "null"]},
    "dense_replay_control_only": {"const": true},
    "supporting_numerical_control_modes": {"type": "array", "items": {"enum": ["same_mask", "math"]}, "uniqueItems": true},
    "local_packed_verifier_numerical_divergence_supported": {"type": "boolean"},
    "reference_probe_argmax_token_id": {"type": ["integer", "null"]},
    "reference_probe_faithful": {"type": ["boolean", "null"]},
    "reference_probe_fidelity_status": {"enum": ["faithful", "unfaithful", "unavailable_no_probe", "unavailable_no_actual_token"]},
    "reference_probe_execution_provenance": {"type": "string"},
    "tree_probe_argmax_token_id": {"type": ["integer", "null"]},
    "tree_probe_faithful": {"type": ["boolean", "null"]},
    "tree_probe_fidelity_status": {"enum": ["faithful", "unfaithful", "unavailable_no_probe", "unavailable_no_actual_token"]},
    "native_dense_replay_control_flip": {"type": "boolean"},
    "same_mask_control_flip": {"type": "boolean"},
    "math_control_flip": {"type": "boolean"},
    "local_packed_verifier_decision_flip": {"type": "boolean"},
    "commit_transition_comparable": {"type": "boolean"},
    "commit_transition_semantics_equal": {"type": ["boolean", "null"]},
    "round_segmentation_equal": {"type": "boolean"},
    "round_segmentation_difference_observed": {"type": "boolean"},
    "transition_overlap_start_offset": {"type": ["integer", "null"], "minimum": 0},
    "transition_overlap_end_offset": {"type": ["integer", "null"], "minimum": 0},
    "transition_overlap_token_exact": {"type": ["boolean", "null"]},
    "transition_overlap_token_count": {"type": "integer", "minimum": 0},
    "first_transition_semantic_mismatch_offset": {"type": ["integer", "null"], "minimum": 0},
    "first_transition_reference_token_id": {"type": ["integer", "null"]},
    "first_transition_tree_token_id": {"type": ["integer", "null"]},
    "segmentation_only_difference": {"type": "boolean"},
    "transition_semantic_mismatch": {"type": "boolean"},
    "transition_mismatch_causal": {"type": "boolean"},
    "numerical_state_difference_observed": {"type": "boolean"},
    "structural_state_difference_observed": {"type": "boolean"},
    "draft_candidate_difference_observed": {"type": "boolean"},
    "semantic_consequence_observed": {"type": "boolean"},
    "mere_numerical_variation_only": {"type": "boolean"},
    "classification_evidence_prefix": {"type": ["integer", "null"], "minimum": 0},
    "classification_evidence_source": {"type": ["string", "null"]},
    "classification_priority": {"type": ["integer", "null"], "minimum": 1, "maximum": 5},
    "classification_evidence_complete": {"type": "boolean"},
    "classification_evidence_issues": {"type": "array", "items": {"type": "string"}},
    "downstream_consequence_only": {"type": "boolean"},
    "unresolved_reason": {"type": ["string", "null"]}
  }
}
