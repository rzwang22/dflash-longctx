{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2d2-correctness-summary.schema.json",
  "title": "Phase 2D.2A correctness summary",
  "type": "object",
  "required": ["schema_version", "status", "official_checker_passed", "target_only_output_exactness_required", "target_only_is_auxiliary_numerical_control", "original_dflash_reference_output_exactness_required", "all_target_only_output_ids_equal", "all_target_only_original_dflash_reference_output_ids_equal", "all_original_dflash_reference_output_ids_equal", "diagnostic_target_only_variation_observed", "target_only_auxiliary_statuses", "actual_execution_correctness_passed", "structural_correctness_passed", "hard_correctness_failure_reasons", "gold_numerical_variation_preserved_as_diagnostics", "records"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["ok", "failed"]},
    "official_checker_passed": {"type": "boolean"},
    "target_only_output_exactness_required": {"const": false},
    "target_only_is_auxiliary_numerical_control": {"const": true},
    "original_dflash_reference_output_exactness_required": {"const": true},
    "all_target_only_output_ids_equal": {"type": "boolean"},
    "all_target_only_original_dflash_reference_output_ids_equal": {"type": "boolean"},
    "all_original_dflash_reference_output_ids_equal": {"type": "boolean"},
    "diagnostic_target_only_variation_observed": {"type": "boolean"},
    "target_only_auxiliary_statuses": {"type": "array", "items": {"enum": ["equal", "target_only_reference_numerical_divergence", "target_only_tree_numerical_divergence"]}},
    "actual_execution_correctness_passed": {"type": "boolean"},
    "structural_correctness_passed": {"type": "boolean"},
    "hard_correctness_failure_reasons": {"type": "array", "items": {"type": "string"}},
    "gold_numerical_variation_preserved_as_diagnostics": {"const": true},
    "records": {"type": "array"}
  }
}
