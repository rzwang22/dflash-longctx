{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2d0-gap-decomposition.schema.json",
  "title": "Phase 2D.0 gap decomposition with explicit denominators",
  "type": "object",
  "required": [
    "schema_version", "phase", "gap_class_priority", "event_count",
    "configuration_round_count", "raw_round_count", "raw_physical_round_count",
    "node_budgets_are_separate_configuration_strata",
    "cross_node_budget_counts_are_configuration_round_counts",
    "task_context", "task_level", "cross_task_macro",
    "round_micro_treats_rounds_as_observations",
    "sample_macro_uses_sample_as_independence_unit",
    "no_cross_task_extrapolation"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "phase": {"const": "2D.0"},
    "gap_class_priority": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "event_count": {"type": "integer", "minimum": 1},
    "configuration_round_count": {"type": "integer", "minimum": 1},
    "raw_round_count": {"type": "integer", "minimum": 1},
    "raw_physical_round_count": {"type": "integer", "minimum": 1},
    "node_budgets_are_separate_configuration_strata": {"const": true},
    "cross_node_budget_counts_are_configuration_round_counts": {"const": true},
    "task_context": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "task_level": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "cross_task_macro": {"type": "array", "items": {"$ref": "#/$defs/row"}},
    "round_micro_treats_rounds_as_observations": {"const": true},
    "sample_macro_uses_sample_as_independence_unit": {"const": true},
    "no_cross_task_extrapolation": {"const": true}
  },
  "$defs": {
    "row": {
      "type": "object",
      "required": [
        "schema_version", "scope", "top_m", "node_budget", "gap_class",
        "gap_class_round_count", "raw_round_count", "eligible_round_count",
        "right_censored_or_terminal_count", "fraction_over_all_rounds",
        "fraction_among_eligible_rounds",
        "fraction_among_eligible_rounds_unavailable_reason",
        "censoring_fraction", "micro_fraction_over_all_rounds",
        "micro_fraction_among_eligible_rounds",
        "macro_fraction_over_all_rounds",
        "macro_fraction_among_eligible_rounds",
        "macro_fraction_among_eligible_rounds_unavailable_reason",
        "fraction_denominator_name", "fraction_denominator_count", "count_unit"
      ],
      "properties": {
        "schema_version": {"const": "2.0"},
        "scope": {"enum": ["task_context", "task_micro_and_sample_macro", "cross_task_macro"]},
        "top_m": {"enum": [2, 4, 8, 16]},
        "node_budget": {"type": "integer", "minimum": 16},
        "gap_class": {"type": "string"},
        "gap_class_round_count": {"type": "integer", "minimum": 0},
        "raw_round_count": {"type": "integer", "minimum": 1},
        "eligible_round_count": {"type": "integer", "minimum": 0},
        "right_censored_or_terminal_count": {"type": "integer", "minimum": 0},
        "fraction_over_all_rounds": {"type": "number", "minimum": 0, "maximum": 1},
        "fraction_among_eligible_rounds": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "fraction_among_eligible_rounds_unavailable_reason": {"type": ["string", "null"]},
        "censoring_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "micro_fraction_over_all_rounds": {"type": "number", "minimum": 0, "maximum": 1},
        "micro_fraction_among_eligible_rounds": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "macro_fraction_over_all_rounds": {"type": "number", "minimum": 0, "maximum": 1},
        "macro_fraction_among_eligible_rounds": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "macro_fraction_among_eligible_rounds_unavailable_reason": {"type": ["string", "null"]},
        "fraction_denominator_name": {"enum": ["all_configuration_rounds", "eligible_configuration_rounds"]},
        "fraction_denominator_count": {"type": "integer", "minimum": 0},
        "count_unit": {"const": "configuration_round_at_fixed_node_budget"}
      }
    }
  }
}
