{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2c-correctness-summary.schema.json",
  "title": "Phase 2C end-to-end correctness summary",
  "type": "object",
  "required": ["schema_version", "status", "all_checks_passed", "records", "error"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["started", "ok", "failed", "error"]},
    "all_checks_passed": {"type": "boolean"},
    "actual_execution_correctness_passed": {"type": "boolean"},
    "actual_output_exactness_required": {"type": "boolean"},
    "diagnostic_numerical_variation_observed": {"type": "boolean"},
    "diagnostic_numerical_variation_reasons": {"type": "array", "items": {"type": "string"}},
    "hard_failure_class": {"type": ["string", "null"]},
    "gold_status": {"enum": ["not_run", "pass_exact", "pass_semantic_with_numerical_variation", "fail_semantic", "fail_structural"]},
    "failure_class": {"type": ["string", "null"]},
    "completed_checks": {"type": "array", "items": {"type": "string"}},
    "uncompleted_checks": {"type": "array", "items": {"type": "string"}},
    "uncompleted_check_details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "reason"],
        "properties": {
          "check": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["task", "sample_id", "nominal_prompt_length", "configuration_id", "reference_output_ids_equal", "control_profile_output_ids_equal", "passed"]
      }
    },
    "error": {"type": ["object", "null"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {"actual_output_exactness_required": {"const": true}},
        "required": ["actual_output_exactness_required"]
      },
      "then": {
        "required": [
          "actual_execution_correctness_passed",
          "diagnostic_numerical_variation_observed"
        ]
      }
    }
  ]
}
