{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2c-summary.schema.json",
  "title": "Phase 2C aggregate summary",
  "type": "object",
  "required": ["schema_version", "sample_record_count", "round_record_count", "groups", "interpretation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "sample_record_count": {"type": "integer", "minimum": 0},
    "round_record_count": {"type": "integer", "minimum": 0},
    "groups": {"type": "array", "items": {"type": "object"}},
    "interpretation": {"type": "object"}
  }
}
