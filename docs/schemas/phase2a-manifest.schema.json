{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2a-manifest.schema.json",
  "title": "Phase 2A run manifest",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "created_at_utc",
    "command",
    "repository",
    "configuration",
    "workload",
    "measurement_policy",
    "accounting_policy",
    "model_position_limit",
    "attention_backend",
    "artifacts",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["started", "ok", "error"]},
    "created_at_utc": {"type": "string"},
    "command": {"type": "string"},
    "repository": {"type": "object"},
    "configuration": {
      "type": "object",
      "required": ["phase", "run_mode", "rank_top_ms", "rank_max_m"],
      "properties": {
        "phase": {"const": "2A"},
        "run_mode": {"enum": ["rank", "verification-profile"]},
        "rank_top_ms": {"type": "array", "items": {"type": "integer"}},
        "rank_max_m": {"type": "integer", "minimum": 16}
      }
    },
    "workload": {
      "type": "object",
      "required": [
        "task",
        "sample_policy",
        "paired_context_length_comparison",
        "inventory",
        "cohort",
        "samples"
      ]
    },
    "measurement_policy": {
      "type": "object",
      "required": [
        "formal_end_to_end_latency_source",
        "rank_timing_included_in_formal_latency",
        "rank_and_verification_profile_mutually_exclusive",
        "output_token_ids_must_match_control",
        "module_self_attention_scope",
        "module_self_attention_is_pure_sdpa",
        "pure_sdpa_requires_nsight_or_ncu"
      ]
    },
    "accounting_policy": {"type": "object"},
    "model_position_limit": {"type": ["integer", "null"]},
    "attention_backend": {"type": ["object", "null"]},
    "artifacts": {"type": "object"},
    "error": {"type": ["object", "null"]}
  }
}
