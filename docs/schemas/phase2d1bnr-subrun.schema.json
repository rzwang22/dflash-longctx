{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2d1bnr-subrun.schema.json",
  "title": "Phase 2D.1B-NR independent subprocess observation",
  "type": "object",
  "required": [
    "schema_version", "experiment", "task", "sample_id", "source_sample_id",
    "nominal_prompt_length", "selector_mode", "node_budget", "repeat_index",
    "max_new_tokens", "physical_case_id", "configuration_case_id",
    "independent_repeat_observation_id", "raw_subrun_dir",
    "subprocess_return_code", "subprocess_nonzero_retained_as_diagnostic",
    "outcome_category"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "experiment": {"enum": ["exact_case", "cohort"]},
    "task": {"const": "gov_report"},
    "sample_id": {"type": "string", "minLength": 1},
    "source_sample_id": {"type": "string", "minLength": 1},
    "nominal_prompt_length": {"type": "integer", "minimum": 1},
    "selector_mode": {"enum": ["top1_packed_tree", "global_fixed"]},
    "node_budget": {"enum": [16, 32]},
    "repeat_index": {"type": "integer", "minimum": 0},
    "max_new_tokens": {"type": "integer", "minimum": 1},
    "physical_case_id": {"type": "string", "minLength": 1},
    "configuration_case_id": {"type": "string", "minLength": 1},
    "independent_repeat_observation_id": {"type": "string", "minLength": 1},
    "raw_subrun_dir": {"type": "string", "minLength": 1},
    "subprocess_return_code": {"type": "integer"},
    "subprocess_nonzero_retained_as_diagnostic": {"type": "boolean"},
    "outcome_category": {"enum": ["pass_actual_exact", "actual_numerical_decision_divergence", "actual_unresolved_semantic_divergence", "diagnostic_only_numerical_variation", "actual_structural_failure", "reference_instability", "incomplete_correctness_evidence", "infrastructure_failure"]},
    "actual_reference_output_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "actual_tree_output_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "target_only_output_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "actual_reference_output_ids": {"type": ["array", "null"], "items": {"type": "integer"}},
    "actual_tree_output_ids": {"type": ["array", "null"], "items": {"type": "integer"}},
    "target_only_output_ids": {"type": ["array", "null"], "items": {"type": "integer"}},
    "actual_reference_tree_output_ids_equal": {"type": ["boolean", "null"]},
    "actual_output_relation_reliable": {"type": "boolean"},
    "actual_divergence_evidence_sufficient": {"type": "boolean"},
    "actual_execution_semantic_failure": {"type": "boolean"},
    "diagnostic_numerical_variation_observed": {"type": "boolean"},
    "gold_or_replay_variation_observed": {"type": "boolean"},
    "unclassified_gold_or_replay_failure_observed": {"type": "boolean"},
    "known_numerical_variation_evidence": {"type": "boolean"},
    "replay_only_variation_observed": {"type": "boolean"},
    "replay_structural_evidence_passed": {"type": "boolean"},
    "diagnostic_classification_evidence_sufficient": {"type": "boolean"},
    "diagnostic_skip_evidence_supported": {"type": "boolean"},
    "gold_status": {"type": ["string", "null"]},
    "gold_failure_class": {"type": ["string", "null"]},
    "unresolved_attribution_reason": {"type": ["string", "null"]},
    "hard_correctness_failure_reasons": {"type": "array", "items": {"type": "string"}},
    "diagnostic_numerical_variation_reasons": {"type": "array", "items": {"type": "string"}},
    "replay_semantic_variation_with_actual_consequence": {"type": "boolean"},
    "gold_evidence_complete": {"type": "boolean"},
    "selector_target_blind": {"type": "boolean"},
    "target_forward_count_added": {"const": 0},
    "actual_node_counts": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "source_provenance_status": {"enum": ["ok", "failed"]},
    "source_provenance_validation_passed": {"type": "boolean"},
    "source_provenance_validation_failures": {"type": "array", "items": {"type": "string"}},
    "source_provenance_wrapper_failure_is_expected_correctness": {"type": "boolean"},
    "first_divergence_gold_comparison_modes_observed": {"type": "array", "items": {"enum": ["native", "equal_shape", "same_mask", "math"]}},
    "first_divergence_replay_decision_mismatch_captured": {"type": "boolean"},
    "structural_traversal_complete_through_first_divergence": {"type": "boolean"},
    "first_replay_variation_round": {"type": ["integer", "null"], "minimum": -1},
    "first_replay_variation_gold_comparison_modes_observed": {"type": "array", "items": {"enum": ["native", "equal_shape", "same_mask", "math"]}},
    "first_replay_variation_evidence_captured": {"type": "boolean"},
    "structural_traversal_complete_through_first_replay_variation": {"type": "boolean"},
    "downstream_gold_checks_skipped_after_confirmed_divergence": {"type": "boolean"},
    "downstream_gold_checks_skipped_after_confirmed_replay_variation": {"type": "boolean"},
    "downstream_gold_skipped_checks": {"type": "array", "items": {"type": "string"}},
    "downstream_gold_skip_reasons": {"type": "array", "items": {"type": "string"}},
    "genuinely_incomplete_correctness_evidence": {"type": "boolean"},
    "gold_incompleteness_reasons": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome_category": {"not": {"const": "infrastructure_failure"}}}},
      "then": {"required": ["actual_reference_output_sha256", "actual_tree_output_sha256", "target_only_output_sha256", "actual_reference_output_ids", "actual_tree_output_ids", "target_only_output_ids", "actual_reference_tree_output_ids_equal", "actual_output_relation_reliable", "actual_divergence_evidence_sufficient", "actual_execution_semantic_failure", "diagnostic_numerical_variation_observed", "gold_or_replay_variation_observed", "unclassified_gold_or_replay_failure_observed", "known_numerical_variation_evidence", "replay_only_variation_observed", "replay_structural_evidence_passed", "diagnostic_classification_evidence_sufficient", "diagnostic_skip_evidence_supported", "gold_status", "gold_failure_class", "unresolved_attribution_reason", "hard_correctness_failure_reasons", "diagnostic_numerical_variation_reasons", "replay_semantic_variation_with_actual_consequence", "gold_evidence_complete", "selector_target_blind", "target_forward_count_added", "actual_node_counts", "source_provenance_status", "source_provenance_validation_passed", "source_provenance_validation_failures", "source_provenance_wrapper_failure_is_expected_correctness", "first_divergence_gold_comparison_modes_observed", "first_divergence_replay_decision_mismatch_captured", "structural_traversal_complete_through_first_divergence", "first_replay_variation_round", "first_replay_variation_gold_comparison_modes_observed", "first_replay_variation_evidence_captured", "structural_traversal_complete_through_first_replay_variation", "downstream_gold_checks_skipped_after_confirmed_divergence", "downstream_gold_checks_skipped_after_confirmed_replay_variation", "downstream_gold_skipped_checks", "downstream_gold_skip_reasons", "genuinely_incomplete_correctness_evidence", "gold_incompleteness_reasons"]}
    },
    {
      "if": {"properties": {"outcome_category": {"const": "pass_actual_exact"}}},
      "then": {"properties": {"actual_reference_tree_output_ids_equal": {"const": true}}}
    },
    {
      "if": {"properties": {"outcome_category": {"const": "actual_numerical_decision_divergence"}}},
      "then": {"properties": {"actual_reference_tree_output_ids_equal": {"const": false}, "structural_correctness_passed": {"const": true}}}
    },
    {
      "if": {"properties": {"outcome_category": {"const": "actual_unresolved_semantic_divergence"}}},
      "then": {"properties": {"actual_reference_tree_output_ids_equal": {"const": false}, "actual_output_relation_reliable": {"const": true}, "actual_divergence_evidence_sufficient": {"const": true}, "unresolved_attribution_reason": {"type": "string", "minLength": 1}, "genuinely_incomplete_correctness_evidence": {"const": false}, "structural_correctness_passed": {"const": true}}}
    },
    {
      "if": {"properties": {"outcome_category": {"const": "diagnostic_only_numerical_variation"}}},
      "then": {"properties": {"actual_reference_tree_output_ids_equal": {"const": true}, "actual_output_relation_reliable": {"const": true}, "diagnostic_numerical_variation_observed": {"const": true}, "gold_or_replay_variation_observed": {"const": true}, "unclassified_gold_or_replay_failure_observed": {"const": false}, "known_numerical_variation_evidence": {"const": true}, "replay_only_variation_observed": {"const": true}, "replay_structural_evidence_passed": {"const": true}, "diagnostic_classification_evidence_sufficient": {"const": true}, "genuinely_incomplete_correctness_evidence": {"const": false}, "structural_correctness_passed": {"const": true}}}
    }
  ]
}
