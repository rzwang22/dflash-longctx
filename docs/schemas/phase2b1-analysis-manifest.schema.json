{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2b1-analysis-manifest.schema.json",
  "title": "Phase 2B.1 analysis manifest",
  "type": "object",
  "required": [
    "schema_version", "phase", "status", "mode", "created_at_utc", "command",
    "repository", "inputs", "configuration", "policy_classes",
    "target_information_usage", "forbidden_interpretations", "event_count", "policy_replay_count", "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "phase": {"const": "2B.1"},
    "status": {"const": "ok"},
    "mode": {"const": "cpu_only_offline_target_path_survival_analysis"},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capture_directory", "capture_directory_sha256", "artifact_sha256", "capture_schema_version", "input_git_sha", "top_k", "task", "sample_count", "round_count"],
        "properties": {
          "capture_directory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "input_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "top_k": {"type": "integer", "minimum": 16}
        }
      }
    },
    "configuration": {
      "type": "object",
      "required": ["captured_top_k_minimum", "rank_cap", "rank_cap_semantics", "node_budgets", "beam_widths", "root_included_in_total_node_budget", "maximum_draft_depth", "scoring_rule", "tie_breaking", "censoring_rule"]
    },
    "event_count": {"type": "integer", "minimum": 1},
    "policy_replay_count": {"type": "integer", "minimum": 1},
    "artifacts": {"type": "array", "minItems": 12, "items": {"type": "string"}}
  }
}
