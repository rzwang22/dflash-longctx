{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2b-capture-round.schema.json",
  "title": "Phase 2B exact-logit candidate capture round",
  "type": "object",
  "required": ["schema_version", "task", "sample_id", "source_sample_id", "source_text_sha256", "capture_source_provenance", "generation_repeat", "round_index", "context_length_before", "root_absolute_output_index", "round_output_start_offset", "root_token_id", "baseline_draft_token_ids", "positions", "top_k", "proposed_draft_token_count", "accepted_draft_token_count", "rejected_draft_token_count", "committed_token_count", "raw_cumulative_generated_token_count", "cumulative_returned_token_count", "returned_token_delta", "stop_reason", "truncated_token_count", "terminal_round", "final_verified_output_token_ids", "reference_target_continuation_token_ids", "reference_observed_depth", "reference_right_censored", "full_depth_evaluation_eligible", "alignment", "full_vocabulary_logits_saved", "target_logits_saved", "model_hidden_states_saved", "kv_cache_saved"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "round_index": {"type": "integer", "minimum": 0},
    "round_output_start_offset": {"type": "integer", "minimum": 0},
    "baseline_draft_token_ids": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"type": "integer"}},
    "positions": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["block_position", "baseline_token_id", "candidates", "top1_top2_log_probability_margin"],
        "properties": {
          "block_position": {"type": "integer", "minimum": 1, "maximum": 15},
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rank", "token_id", "log_probability"],
              "properties": {
                "rank": {"type": "integer", "minimum": 1, "maximum": 16},
                "token_id": {"type": "integer"},
                "log_probability": {"type": "number"}
              }
            }
          }
        }
      }
    },
    "top_k": {"type": "integer", "minimum": 2, "maximum": 16},
    "proposed_draft_token_count": {"const": 15},
    "accepted_draft_token_count": {"type": "integer", "minimum": 0, "maximum": 15},
    "reference_target_continuation_token_ids": {"type": "array", "maxItems": 15, "items": {"type": "integer"}},
    "reference_observed_depth": {"type": "integer", "minimum": 0, "maximum": 15},
    "reference_right_censored": {"type": "boolean"},
    "alignment": {
      "type": "object",
      "required": ["status", "final_output_lcp", "accepted_draft_token_count", "exact_lcp_invariant_evaluable", "exact_lcp_invariant_holds", "immediate_verification_lcp", "immediate_verification_invariant_holds"]
    },
    "full_vocabulary_logits_saved": {"const": false},
    "target_logits_saved": {"const": false},
    "model_hidden_states_saved": {"const": false},
    "kv_cache_saved": {"const": false}
  }
}
