{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2d0-signal-label.schema.json",
  "title": "Phase 2D.0 D1-ready signal and offline-label row",
  "type": "object",
  "required": [
    "schema_version", "task", "sample_id", "nominal_prompt_length",
    "generation_repeat", "round_index", "top_m", "node_budget",
    "position_index",
    "deployable_features", "labels", "label_eligible",
    "label_unavailable_reason", "feature_contract", "label_contract",
    "top_m_entropy_semantics"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task": {"enum": ["gov_report", "qasper", "hotpotqa"]},
    "sample_id": {"type": "string", "minLength": 1},
    "nominal_prompt_length": {"type": "integer", "minimum": 1},
    "generation_repeat": {"type": "integer", "minimum": 0},
    "round_index": {"type": "integer", "minimum": 0},
    "top_m": {"type": "integer", "minimum": 2, "maximum": 16},
    "node_budget": {"type": "integer", "minimum": 16},
    "position_index": {"type": "integer", "minimum": 1, "maximum": 15},
    "deployable_features": {"$ref": "#/$defs/features"},
    "labels": {"$ref": "#/$defs/labels"},
    "label_eligible": {"type": "boolean"},
    "label_unavailable_reason": {"type": ["string", "null"]},
    "feature_contract": {"const": "draft_side_target_blind_at_deployment"},
    "label_contract": {"const": "target_dependent_offline_diagnostic_only"},
    "top_m_entropy_semantics": {"type": "string", "pattern": "not full-vocabulary entropy"}
  },
  "$defs": {
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position_index", "top1_log_probability",
        "top1_top2_log_probability_margin", "top_m_probability_mass",
        "top_m_renormalized_entropy", "adjacent_position_confidence_change",
        "adjacent_position_confidence_change_unavailable_reason",
        "static_beam_score", "static_beam_score_unavailable_reason",
        "surviving_prefix_count", "tree_depth", "context_length", "top_m",
        "node_budget"
      ],
      "properties": {
        "position_index": {"type": "integer", "minimum": 1, "maximum": 15},
        "top1_log_probability": {"type": "number"},
        "top1_top2_log_probability_margin": {"type": "number"},
        "top_m_probability_mass": {"type": "number", "minimum": 0},
        "top_m_renormalized_entropy": {"type": "number", "minimum": 0},
        "adjacent_position_confidence_change": {"type": ["number", "null"]},
        "adjacent_position_confidence_change_unavailable_reason": {"type": ["string", "null"]},
        "static_beam_score": {"type": ["number", "null"]},
        "static_beam_score_unavailable_reason": {"type": ["string", "null"]},
        "surviving_prefix_count": {"type": "integer", "minimum": 0},
        "tree_depth": {"type": "integer", "minimum": 1, "maximum": 15},
        "context_length": {"type": "integer", "minimum": 1},
        "top_m": {"enum": [2, 4, 8, 16]},
        "node_budget": {"type": "integer", "minimum": 16}
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_availability_failure", "all_tested_static_path_failure",
        "dependency_realization_opportunity", "first_critical_depth_position",
        "first_critical_depth", "target_token_rank", "target_token_in_top_m",
        "accepted_draft_depth", "gap_class"
      ],
      "properties": {
        "candidate_availability_failure": {"type": ["boolean", "null"]},
        "all_tested_static_path_failure": {"type": ["boolean", "null"]},
        "dependency_realization_opportunity": {"type": ["boolean", "null"]},
        "first_critical_depth_position": {"type": ["boolean", "null"]},
        "first_critical_depth": {"type": ["integer", "null"], "minimum": 1, "maximum": 15},
        "target_token_rank": {"type": ["integer", "null"], "minimum": 1, "maximum": 16},
        "target_token_in_top_m": {"type": ["boolean", "null"]},
        "accepted_draft_depth": {"type": "integer", "minimum": 0, "maximum": 15},
        "gap_class": {
          "enum": [
            "right_censored_or_terminal",
            "no_failure_within_observed_horizon",
            "candidate_availability_failure",
            "selection_failure",
            "budget_failure",
            "dependency_realization_opportunity",
            "possible_dependency_opportunity",
            "unresolved"
          ]
        }
      }
    }
  }
}
