{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2d0-research-question-summary.schema.json",
  "title": "Phase 2D.0 RQ1-RQ6 summary",
  "type": "object",
  "required": [
    "schema_version", "phase", "rq1", "rq2", "rq3", "rq4", "rq5",
    "rq6", "eligible_configuration_round_count", "task_count",
    "gap_class_counts", "core_configuration", "decision",
    "no_dependency_dominance_claim_without_capture_results"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "phase": {"const": "2D.0"},
    "rq1": {"type": "object"},
    "rq2": {"type": "object"},
    "rq3": {"type": "object"},
    "rq4": {"type": "object"},
    "rq5": {"type": "object"},
    "rq6": {"type": "object", "required": ["question", "decision", "decision_rules"]},
    "eligible_configuration_round_count": {"type": "integer", "minimum": 0},
    "task_count": {"type": "integer", "minimum": 0},
    "gap_class_counts": {"type": "object"},
    "core_configuration": {"type": "object"},
    "decision": {"enum": ["continue_dependency_refinement", "prioritize_candidate_generation", "prioritize_selector", "mixed_problem", "insufficient_evidence"]},
    "no_dependency_dominance_claim_without_capture_results": {"const": true}
  }
}
