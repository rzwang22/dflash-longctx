{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2d1-selector-event.schema.json",
  "title": "Phase 2D.1A eligible round selector event",
  "type": "object",
  "required": [
    "schema_version", "task", "sample_id", "source_sample_id",
    "source_cluster_id", "source_text_sha256", "nominal_prompt_length",
    "actual_prompt_length", "generation_repeat",
    "round_index", "physical_round_id", "top_m", "node_budget_cap",
    "count_unit", "root_included_in_node_budget", "top1_config_id",
    "top1_coverage_depth", "top1_actual_constructed_node_count",
    "policy_configurations", "policy_oracle_coverage_depth",
    "policy_oracle_winner_config_ids", "policy_oracle_tie_count",
    "policy_oracle_is_deployable", "policy_oracle_non_deployable_reason",
    "prefix_closed_target_oracle_coverage_depth",
    "prefix_closed_target_oracle_is_deployable",
    "prefix_closed_target_oracle_non_deployable_reason", "candidate_availability_prefix",
    "candidate_available_for_extension", "policy_oracle_headroom",
    "runtime_features", "runtime_feature_names",
    "runtime_features_use_target_information",
    "top16_entropy_semantics", "offline_target_prefix_coverage_only",
    "actual_online_acceptance_derived", "latency_or_speedup_derived"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task": {"enum": ["gov_report", "qasper", "hotpotqa"]},
    "source_cluster_id": {"type": "string", "minLength": 1},
    "source_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nominal_prompt_length": {"type": "integer", "minimum": 1},
    "actual_prompt_length": {"type": "integer", "minimum": 1},
    "generation_repeat": {"type": "integer", "minimum": 0},
    "round_index": {"type": "integer", "minimum": 0},
    "top_m": {"const": 16},
    "node_budget_cap": {"enum": [16, 32]},
    "count_unit": {"const": "eligible_physical_round_at_fixed_node_budget"},
    "root_included_in_node_budget": {"const": true},
    "top1_coverage_depth": {"type": "integer", "minimum": 0, "maximum": 15},
    "top1_actual_constructed_node_count": {"type": "integer", "minimum": 1},
    "policy_configurations": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/policy_configuration"}},
    "policy_oracle_coverage_depth": {"type": "integer", "minimum": 0, "maximum": 15},
    "policy_oracle_winner_config_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "policy_oracle_tie_count": {"type": "integer", "minimum": 1},
    "policy_oracle_is_deployable": {"const": false},
    "policy_oracle_non_deployable_reason": {"type": "string", "minLength": 1},
    "prefix_closed_target_oracle_coverage_depth": {"type": "integer", "minimum": 0, "maximum": 15},
    "prefix_closed_target_oracle_is_deployable": {"const": false},
    "prefix_closed_target_oracle_non_deployable_reason": {"type": "string", "minLength": 1},
    "candidate_availability_prefix": {"type": "integer", "minimum": 0, "maximum": 15},
    "candidate_available_for_extension": {"type": "boolean"},
    "policy_oracle_headroom": {"type": "integer", "minimum": 0, "maximum": 15},
    "runtime_features": {"$ref": "#/$defs/runtime_features"},
    "runtime_feature_names": {"type": "array", "minItems": 14, "maxItems": 14, "uniqueItems": true, "items": {"type": "string"}},
    "runtime_features_use_target_information": {"const": false},
    "top16_entropy_semantics": {"type": "string", "pattern": "not full-vocabulary entropy"},
    "offline_target_prefix_coverage_only": {"const": true},
    "actual_online_acceptance_derived": {"const": false},
    "latency_or_speedup_derived": {"const": false}
  },
  "$defs": {
    "policy_configuration": {
      "type": "object",
      "required": ["config_id", "policy", "policy_variant", "policy_parameters", "top_m", "coverage_depth", "actual_constructed_node_count", "node_budget_cap", "budget_utilization", "coverage_depth_per_actual_node", "same_budget_cap_comparison", "same_actual_node_count_comparison", "root_included_in_node_count", "policy_construction_uses_target_information", "gain_over_top1", "regret_to_policy_oracle", "regret_to_prefix_closed_target_oracle", "candidate_availability_prefix"],
      "properties": {
        "config_id": {"type": "string", "pattern": "^policy="},
        "policy": {"enum": ["top1_chain", "score_beam", "confidence_gated", "layerwise_beam"]},
        "policy_variant": {"type": "string", "minLength": 1},
        "policy_parameters": {"type": "object"},
        "top_m": {"const": 16},
        "coverage_depth": {"type": "integer", "minimum": 0, "maximum": 15},
        "actual_constructed_node_count": {"type": "integer", "minimum": 1, "maximum": 32},
        "node_budget_cap": {"enum": [16, 32]},
        "budget_utilization": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "coverage_depth_per_actual_node": {"type": "number", "minimum": 0},
        "same_budget_cap_comparison": {"const": true},
        "same_actual_node_count_comparison": {"type": "boolean"},
        "root_included_in_node_count": {"const": true},
        "policy_construction_uses_target_information": {"const": false},
        "gain_over_top1": {"type": "integer"},
        "regret_to_policy_oracle": {"type": "integer", "minimum": 0},
        "regret_to_prefix_closed_target_oracle": {"type": "integer", "minimum": 0},
        "candidate_availability_prefix": {"type": "integer", "minimum": 0, "maximum": 15}
      }
    },
    "runtime_features": {
      "type": "object",
      "required": ["context_length", "node_budget_cap", "mean_top1_log_probability", "min_top1_log_probability", "mean_top1_top2_margin", "min_top1_top2_margin", "mean_top16_cumulative_probability_mass", "mean_top16_renormalized_entropy", "mean_adjacent_confidence_change", "mean_surviving_prefix_count", "mean_static_beam_score", "min_static_beam_score", "tree_depth", "policy_configuration_count"],
      "additionalProperties": false,
      "properties": {
        "context_length": {"type": "number", "minimum": 1},
        "node_budget_cap": {"enum": [16.0, 32.0]},
        "mean_top1_log_probability": {"type": "number"},
        "min_top1_log_probability": {"type": "number"},
        "mean_top1_top2_margin": {"type": "number"},
        "min_top1_top2_margin": {"type": "number"},
        "mean_top16_cumulative_probability_mass": {"type": "number", "minimum": 0},
        "mean_top16_renormalized_entropy": {"type": "number", "minimum": 0},
        "mean_adjacent_confidence_change": {"type": "number"},
        "mean_surviving_prefix_count": {"type": "number", "minimum": 0},
        "mean_static_beam_score": {"type": "number"},
        "min_static_beam_score": {"type": "number"},
        "tree_depth": {"const": 15.0},
        "policy_configuration_count": {"type": "number", "minimum": 4}
      }
    }
  }
}
