{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase1-round.schema.json",
  "title": "One Phase 1A speculative round",
  "type": "object",
  "required": [
    "measurement_run",
    "round_index",
    "context_length_before",
    "context_length_after",
    "draft_block_size",
    "proposed_draft_token_count",
    "accepted_draft_token_count",
    "rejected_draft_token_count",
    "pending_target_seed_token_count",
    "committed_token_count",
    "target_only_or_bonus_token_count",
    "bonus_token_count",
    "correction_token_count",
    "target_token_kind",
    "raw_cumulative_generated_token_count",
    "cumulative_generated_token_count",
    "returned_token_delta",
    "truncated_token_count",
    "remaining_output_budget_before",
    "stop_reason",
    "conservation",
    "draft_input_shapes",
    "draft_output_shapes",
    "target_verification_input_shapes",
    "target_verification_output_shapes",
    "attention_calls",
    "target_attention",
    "timing",
    "gpu_memory"
  ],
  "properties": {
    "measurement_run": {"type": "integer", "minimum": 0},
    "round_index": {"type": "integer", "minimum": 0},
    "context_length_before": {"type": "integer", "minimum": 0},
    "context_length_after": {"type": "integer", "minimum": 0},
    "draft_block_size": {"type": "integer", "minimum": 2},
    "proposed_draft_token_count": {"type": "integer", "minimum": 1},
    "accepted_draft_token_count": {"type": "integer", "minimum": 0},
    "rejected_draft_token_count": {"type": "integer", "minimum": 0},
    "pending_target_seed_token_count": {"const": 1},
    "committed_token_count": {"type": "integer", "minimum": 1},
    "target_only_or_bonus_token_count": {"const": 1},
    "bonus_token_count": {"enum": [0, 1]},
    "correction_token_count": {"enum": [0, 1]},
    "target_token_kind": {"enum": ["bonus", "correction"]},
    "raw_cumulative_generated_token_count": {"type": "integer", "minimum": 1},
    "cumulative_generated_token_count": {"type": "integer", "minimum": 0},
    "returned_token_delta": {"type": "integer", "minimum": 0},
    "truncated_token_count": {"type": "integer", "minimum": 0},
    "remaining_output_budget_before": {"type": "integer", "minimum": 1},
    "stop_reason": {"enum": ["continue", "eos", "max_new_tokens"]},
    "conservation": {
      "type": "object",
      "additionalProperties": {"const": true}
    },
    "draft_input_shapes": {"type": "object"},
    "draft_output_shapes": {"type": "object"},
    "target_verification_input_shapes": {"type": "object"},
    "target_verification_output_shapes": {"type": "object"},
    "attention_calls": {"type": "array", "items": {"type": "object"}},
    "target_attention": {"type": "object"},
    "timing": {"type": "object"},
    "gpu_memory": {"type": ["object", "null"]}
  }
}
