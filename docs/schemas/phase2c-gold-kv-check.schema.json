{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2c-gold-kv-check.schema.json",
  "title": "Phase 2C compacted-cache versus dense recomputation gold check",
  "type": "object",
  "required": ["schema_version", "task", "sample_id", "nominal_prompt_length", "configuration_id", "round_index", "status", "greedy_argmax_equal", "top_k_token_ids_equal", "within_bfloat16_tolerance", "compacted_layer_lengths", "next_step_layer_lengths", "dense_reference_layer_lengths", "length_checks", "sibling_nodes_discarded", "correction_or_bonus_absent_from_persistent_cache"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "passed"},
    "greedy_argmax_equal": {"const": true},
    "top_k_token_ids_equal": {"const": true},
    "within_bfloat16_tolerance": {"const": true},
    "compacted_layer_lengths": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
    "next_step_layer_lengths": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
    "dense_reference_layer_lengths": {"type": "array", "minItems": 1, "items": {"type": "integer"}},
    "length_checks": {"type": "object"},
    "sibling_nodes_discarded": {"const": true},
    "correction_or_bonus_absent_from_persistent_cache": {"const": true}
  }
}
