{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2c-gold-kv-check.schema.json",
  "title": "Phase 2C/2C.1 compacted-cache gold record",
  "type": "object",
  "required": ["schema_version", "task", "sample_id", "nominal_prompt_length", "configuration_id", "round_index", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"enum": ["passed", "pass_exact", "pass_semantic_with_numerical_variation", "fail_semantic", "fail_structural", "not_run"]},
    "availability": {"enum": ["available", "unavailable"]},
    "comparison_mode": {"const": "dense_committed_path"},
    "backend": {"type": "string"},
    "dtype": {"type": "string"},
    "structural_status": {"enum": ["pass", "fail", "not_run"]},
    "semantic_status": {"enum": ["pass", "fail", "not_run"]},
    "numerical_status": {"type": "string"},
    "thresholds": {"type": "object"},
    "warning": {"type": ["string", "null"]},
    "reason": {"type": ["string", "null"]},
    "provenance": {"type": "object"},
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "k": {"$ref": "#/$defs/tensorErrorStats"},
          "v": {"$ref": "#/$defs/tensorErrorStats"}
        }
      }
    },
    "next_step_layer_lengths": {"type": "array", "items": {"type": "integer"}},
    "dense_reference_layer_lengths": {"type": "array", "items": {"type": "integer"}}
  },
  "$defs": {
    "tensorErrorStats": {
      "type": "object",
      "properties": {
        "max_abs_error": {"type": "number", "minimum": 0},
        "mean_abs_error": {"type": "number", "minimum": 0},
        "p99_abs_error": {"type": "number", "minimum": 0},
        "element_count": {"type": "integer", "minimum": 1},
        "quantile_backend": {"type": "string", "minLength": 1},
        "quantile_input_numel": {"type": "integer", "minimum": 1},
        "quantile_input_dtype": {"type": "string", "minLength": 1},
        "quantile_input_device": {"type": "string", "minLength": 1},
        "quantile_probability": {"type": "number", "minimum": 0, "maximum": 1},
        "quantile_interpolation": {"const": "linear"},
        "large_tensor_quantile_fallback_used": {"type": "boolean"}
      }
    }
  },
  "allOf": [
    {
      "if": {"required": ["availability"]},
      "then": {"required": ["comparison_mode", "backend", "dtype", "structural_status", "semantic_status", "numerical_status", "thresholds", "warning", "reason", "provenance"]}
    }
  ]
}
