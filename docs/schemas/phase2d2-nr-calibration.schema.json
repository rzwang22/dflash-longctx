{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2d2-nr-calibration.schema.json",
  "title": "Phase 2D.2A NR margin calibration",
  "type": "object",
  "required": ["schema_version", "source_phase", "independent_calibration_cohort", "decision_margin_threshold", "source_artifacts", "provenance", "evaluation_outputs_used_to_choose_threshold", "formal_error_bound_claimed", "empirically_validated_guard_only", "calibration_sha256"],
  "properties": {
    "schema_version": {"const": "phase2d2a-nr-calibration-v1"},
    "source_phase": {"const": "2D.1B-NR"},
    "independent_calibration_cohort": {"const": true},
    "decision_margin_threshold": {"const": 0.25},
    "source_artifacts": {
      "type": "object",
      "required": ["nr_directory", "nr_manifest_sha256", "margin_trigger_sweep_sha256", "nr_acceptance_checker_result", "qualifying_rows", "cohort_overall_strata", "observed_actual_divergence_outcome_counts", "observed_actual_divergence_round_count", "observed_divergence_rounds_caught_by_trigger", "observed_false_negative_count", "minimum_preregistered_zero_false_negative_threshold"],
      "properties": {
        "nr_directory": {"type": "string", "minLength": 1},
        "nr_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "margin_trigger_sweep_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "nr_acceptance_checker_result": {
          "type": "object",
          "required": ["status", "subrun_count", "physical_case_count", "configuration_case_count", "actual_divergence_event_count"],
          "properties": {
            "status": {"const": "pass"},
            "subrun_count": {"const": 45},
            "physical_case_count": {"const": 15},
            "configuration_case_count": {"const": 45},
            "actual_divergence_event_count": {"const": 4}
          }
        },
        "qualifying_rows": {"type": "array", "minItems": 1},
        "cohort_overall_strata": {"type": "array", "minItems": 1},
        "observed_actual_divergence_outcome_counts": {
          "type": "object",
          "required": ["actual_numerical_decision_divergence", "actual_unresolved_semantic_divergence"],
          "properties": {
            "actual_numerical_decision_divergence": {"const": 1},
            "actual_unresolved_semantic_divergence": {"const": 3}
          }
        },
        "observed_actual_divergence_round_count": {"const": 4},
        "observed_divergence_rounds_caught_by_trigger": {"const": 4},
        "observed_false_negative_count": {"const": 0},
        "minimum_preregistered_zero_false_negative_threshold": {"const": 0.25}
      }
    },
    "provenance": {
      "type": "object",
      "required": ["gpu_name", "compute_capability", "dtype", "target_model_revision", "draft_model_revision", "torch_version", "transformers_version", "target_attention_implementation"],
      "properties": {
        "gpu_name": {"type": "string", "minLength": 1},
        "compute_capability": {"type": "string", "minLength": 1},
        "dtype": {"type": "string", "minLength": 1},
        "target_model_revision": {"type": "string", "minLength": 1},
        "draft_model_revision": {"type": "string", "minLength": 1},
        "torch_version": {"type": "string", "minLength": 1},
        "transformers_version": {"type": "string", "minLength": 1},
        "target_attention_implementation": {"const": "sdpa"}
      }
    },
    "evaluation_outputs_used_to_choose_threshold": {"const": false},
    "formal_error_bound_claimed": {"const": false},
    "empirically_validated_guard_only": {"const": true},
    "calibration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
