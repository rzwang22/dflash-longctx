{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2d2-sample.schema.json",
  "title": "Phase 2D.2A sample",
  "type": "object",
  "required": ["schema_version", "task", "sample_id", "nominal_prompt_length", "actual_prompt_length", "configuration_id", "candidate_merge_mode", "verification_mode", "node_budget", "generated_token_count", "generated_output_token_ids", "target_only", "original_dflash_reference", "formal_timing_repeats", "profiling", "diagnostics", "correctness"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "nominal_prompt_length": {"type": "integer", "minimum": 1},
    "actual_prompt_length": {"type": "integer", "minimum": 1},
    "node_budget": {"enum": [16, 32]},
    "generated_output_token_ids": {"type": "array", "items": {"type": "integer"}},
    "formal_timing_repeats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["repeat", "generated_output_token_ids_sha256", "generated_token_count", "output_ids_equal_repeat_0", "first_divergent_generated_offset_vs_repeat_0"],
        "properties": {
          "repeat": {"type": "integer", "minimum": 0},
          "generated_output_token_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "generated_token_count": {"type": "integer", "minimum": 0},
          "output_ids_equal_repeat_0": {"type": "boolean"},
          "first_divergent_generated_offset_vs_repeat_0": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    },
    "profiling": {"$ref": "#/$defs/diagnosticExecution"},
    "diagnostics": {"$ref": "#/$defs/diagnosticExecution"},
    "correctness": {"type": "object", "required": ["target_only_output_ids_equal", "target_only_original_dflash_reference_output_ids_equal", "original_dflash_reference_output_ids_equal", "actual_reference_tree_output_ids_equal", "target_only_is_auxiliary_numerical_control", "target_only_mismatch_is_hard_failure", "target_only_auxiliary_status", "target_only_auxiliary_warnings", "base_only_reference_tree_output_exactness_required", "base_only_reference_tree_output_ids_equal", "actual_execution_correctness_passed", "structural_checks_passed", "passed"]}
  },
  "$defs": {
    "diagnosticExecution": {
      "type": "object",
      "required": ["generated_output_token_ids_sha256", "generated_token_count", "output_ids_equal_formal", "first_divergent_generated_offset_vs_reference"],
      "properties": {
        "generated_output_token_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "generated_token_count": {"type": "integer", "minimum": 0},
        "output_ids_equal_formal": {"type": "boolean"},
        "first_divergent_generated_offset_vs_reference": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  }
}
