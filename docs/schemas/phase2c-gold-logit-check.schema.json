{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rzwang22/dflash-longctx/docs/schemas/phase2c-gold-logit-check.schema.json",
  "title": "Phase 2C packed-tree versus linear-path logit gold check",
  "type": "object",
  "required": ["schema_version", "task", "sample_id", "nominal_prompt_length", "configuration_id", "round_index", "status", "checked_node_count", "all_tree_nodes_checked", "greedy_argmax_all_equal", "top_k_token_ids_all_equal", "maximum_absolute_error", "mean_absolute_error", "maximum_absolute_tolerance", "mean_absolute_tolerance", "nodes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "status": {"const": "passed"},
    "checked_node_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "all_tree_nodes_checked": {"const": true},
    "greedy_argmax_all_equal": {"const": true},
    "top_k_token_ids_all_equal": {"const": true},
    "maximum_absolute_error": {"type": "number", "minimum": 0},
    "mean_absolute_error": {"type": "number", "minimum": 0},
    "maximum_absolute_tolerance": {"type": "number", "minimum": 0},
    "mean_absolute_tolerance": {"type": "number", "minimum": 0},
    "nodes": {"type": "array", "minItems": 1}
  }
}
